# ─── Site identity ────────────────────────────────────────────────────────────
NEXT_PUBLIC_OWNER_NAME=Your Name
NEXT_PUBLIC_SITE_CITY=Your City
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ─── LINE contact ─────────────────────────────────────────────────────────────
# Get your LINE contact URL from LINE app → Profile → Share profile link
NEXT_PUBLIC_LINE_CONTACT_URL=https://line.me/ti/p/~your_line_id

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier is enough
RESEND_API_KEY=re_your_api_key
CONTACT_EMAIL=you@example.com
# Use Resend's shared domain while testing, or add your own verified domain
RESEND_FROM_EMAIL=onboarding@resend.dev
